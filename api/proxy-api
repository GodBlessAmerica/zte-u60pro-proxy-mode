#!/bin/sh

BASE=/data/proxy-mode
CLI="$BASE/bin/proxy-mode"
TOKEN_FILE="$BASE/runtime/web.token"

json_header() {
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
}

json_error() {
    code="$1"; msg="$2"
    printf 'Status: %s\r\n' "$code"
    json_header
    printf '{"ok":false,"error":"%s"}\n' "$msg"
    exit 0
}

require_token() {
    [ -f "$TOKEN_FILE" ] || json_error '503 Service Unavailable' 'web token is not configured'
    expected="$(cat "$TOKEN_FILE" 2>/dev/null)"
    supplied="${HTTP_X_PROXY_TOKEN:-}"
    [ -n "$expected" ] && [ "$supplied" = "$expected" ] || json_error '403 Forbidden' 'invalid token'
}

qparam() {
    key="$1"
    printf '%s' "${QUERY_STRING:-}" | tr '&' '\n' | sed -n "s/^${key}=//p" | head -n1 | sed 's/%3A/:/g;s/%3a/:/g'
}

traffic_mode() {
    [ -f "$BASE/runtime/traffic_mode" ] && cat "$BASE/runtime/traffic_mode" || printf off
}

status_json() {
    state=stopped; mode=unconfigured; pid=none
    if [ -f "$BASE/runtime/sing-box.pid" ]; then
        p="$(cat "$BASE/runtime/sing-box.pid" 2>/dev/null)"
        if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then state=running; pid="$p"; fi
    fi
    [ -f "$BASE/runtime/current_mode" ] && mode="$(cat "$BASE/runtime/current_mode" 2>/dev/null)"
    tm="$(traffic_mode)"
    json_header
    printf '{"ok":true,"state":"%s","mode":"%s","pid":"%s","lan":"br-lan","wan":"rmnet_data0","traffic_mode":"%s"}\n' "$state" "$mode" "$pid" "$tm"
}

clients_json() {
    json_header
    printf '{"ok":true,"clients":['
    first=1
    ip neigh show dev br-lan 2>/dev/null | awk 'NF>=5 && $1 ~ /^[0-9]+\./ && $5 ~ /^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$/ {print $1, tolower($5), $NF}' | while read -r ip mac state; do
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '{"ip":"%s","mac":"%s","state":"%s"}' "$ip" "$mac" "$state"
    done
    printf ']}\n'
}

path="${PATH_INFO:-/status}"
method="${REQUEST_METHOD:-GET}"

case "$path" in
    /status)
        [ "$method" = GET ] || json_error '405 Method Not Allowed' 'GET required'
        status_json
        ;;
    /clients)
        [ "$method" = GET ] || json_error '405 Method Not Allowed' 'GET required'
        clients_json
        ;;
    /start|/stop|/restart)
        [ "$method" = POST ] || json_error '405 Method Not Allowed' 'POST required'
        require_token
        action="${path#/}"
        if output="$($CLI "$action" 2>&1)"; then
            json_header
            printf '{"ok":true,"message":"%s"}\n' "$(printf '%s' "$output" | tr '\n' ' ' | sed 's/"/\\"/g')"
        else
            json_error '500 Internal Server Error' 'proxy command failed'
        fi
        ;;
    /traffic)
        [ "$method" = POST ] || json_error '405 Method Not Allowed' 'POST required'
        require_token
        action="$(qparam action)"
        case "$action" in on|off|selective) ;; *) json_error '400 Bad Request' 'invalid traffic action' ;; esac
        if output="$($CLI traffic "$action" 2>&1)"; then
            json_header
            printf '{"ok":true,"message":"%s"}\n' "$(printf '%s' "$output" | tr '\n' ' ' | sed 's/"/\\"/g')"
        else
            json_error '500 Internal Server Error' 'traffic command failed'
        fi
        ;;
    /device)
        [ "$method" = POST ] || json_error '405 Method Not Allowed' 'POST required'
        require_token
        selector="$(qparam selector)"
        action="$(qparam action)"
        [ -n "$selector" ] || json_error '400 Bad Request' 'device selector required'
        case "$action" in proxy|direct) ;; *) json_error '400 Bad Request' 'invalid device action' ;; esac
        if output="$($CLI device "$selector" "$action" 2>&1)"; then
            json_header
            printf '{"ok":true,"message":"%s"}\n' "$(printf '%s' "$output" | tr '\n' ' ' | sed 's/"/\\"/g')"
        else
            json_error '500 Internal Server Error' 'device command failed'
        fi
        ;;
    /use)
        [ "$method" = POST ] || json_error '405 Method Not Allowed' 'POST required'
        require_token
        mode="$(qparam mode)"
        echo "$mode" | grep -Eq '^[0-9]+$' || json_error '400 Bad Request' 'numeric mode required'
        if output="$($CLI use "$mode" 2>&1)"; then
            json_header
            printf '{"ok":true,"message":"%s"}\n' "$(printf '%s' "$output" | tr '\n' ' ' | sed 's/"/\\"/g')"
        else
            json_error '500 Internal Server Error' 'mode switch failed'
        fi
        ;;
    *) json_error '404 Not Found' 'unknown endpoint' ;;
esac
