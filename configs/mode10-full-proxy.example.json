{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "mode10-vless"
      }
    ]
  },
  "inbounds": [
    {
      "type": "redirect",
      "tag": "tcp-redirect-in",
      "listen": "0.0.0.0",
      "listen_port": 7893
    },
    {
      "type": "tproxy",
      "tag": "udp-tproxy-in",
      "listen": "0.0.0.0",
      "listen_port": 7894,
      "network": "udp"
    },
    {
      "type": "direct",
      "tag": "dns4-proxy-in",
      "listen": "0.0.0.0",
      "listen_port": 5353,
      "override_address": "1.1.1.1",
      "override_port": 53
    },
    {
      "type": "direct",
      "tag": "dns6-proxy-in",
      "listen": "::",
      "listen_port": 5354,
      "override_address": "1.1.1.1",
      "override_port": 53
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "mode10-vless",
      "server": "YOUR_SERVER_IP",
      "server_port": 443,
      "uuid": "YOUR_UUID",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "server_name": "YOUR_SNI",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "YOUR_REALITY_PUBLIC_KEY",
          "short_id": "YOUR_SHORT_ID"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "inbound": [
          "dns4-proxy-in",
          "dns6-proxy-in"
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": 123,
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "mode10-vless"
  }
}
