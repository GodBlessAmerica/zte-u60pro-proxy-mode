#!/bin/sh
set -eu

BASE=/data/proxy-mode
SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(dirname "$SELF_DIR")"
START="$ROOT_DIR/scripts/start.sh"
STOP="$ROOT_DIR/scripts/stop.sh"
PREFLIGHT="$ROOT_DIR/scripts/preflight.sh"
TRAFFIC="$ROOT_DIR/scripts/traffic.sh"
GUARD="$ROOT_DIR/scripts/guard-control.sh"
UDP_TUN="$ROOT_DIR/scripts/udp-tun.sh"
LEGACY_TPROXY="$ROOT_DIR/scripts/udp-tproxy.sh"

usage() {
    cat <<'EOF'
Usage:
  proxy-mode status
  proxy-mode preflight
  proxy-mode list
  proxy-mode use <number>
  proxy-mode start [number]
  proxy-mode stop
  proxy-mode restart [number]
  proxy-mode check [number]
  proxy-mode traffic on|off|selective|status
  proxy-mode device <ip|mac> proxy|direct
  proxy-mode guard status
  proxy-mode guard udp strict|off
  proxy-mode guard ipv6 strict|off
  proxy-mode fullproxy status|on|off
EOF
}

current_mode() {
    cat "$BASE/runtime/current_mode" 2>/dev/null || echo unconfigured
}

apply_guard() {
    [ -x "$GUARD" ] && "$GUARD" apply || true
}

apply_full_proxy() {
    [ -x "$UDP_TUN" ] || return 0

    # First remove the abandoned TPROXY experiment. Both old and new helpers
    # historically used runtime/full_proxy_udp, so cleanup must happen before
    # enabling Mode 11 or it would overwrite the working TUN state back to off.
    [ -x "$LEGACY_TPROXY" ] && "$LEGACY_TPROXY" off >/dev/null 2>&1 || true

    mode="$(current_mode)"
    if [ "$mode" = "11" ]; then
        # Guard is applied first. udp-tun.sh then inserts its marked-TUN
        # FORWARD accepts at the top, while table 167 has a blackhole fallback.
        "$UDP_TUN" apply
    else
        "$UDP_TUN" off >/dev/null 2>&1 || true
    fi
}

status() {
    pid=""
    [ -f "$BASE/runtime/sing-box.pid" ] && pid="$(cat "$BASE/runtime/sing-box.pid" 2>/dev/null || true)"
    mode="$(current_mode)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then state="running"; else state="stopped"; fi
    echo "state=$state"
    echo "mode=$mode"
    echo "pid=${pid:-none}"
    echo "lan=br-lan"
    echo "wan=rmnet_data0"
    [ -x "$TRAFFIC" ] && "$TRAFFIC" status || true
    [ -x "$GUARD" ] && "$GUARD" status || true
    [ -x "$UDP_TUN" ] && "$UDP_TUN" status || true
}

list_modes() {
    found=0
    for f in "$BASE"/configs/mode*.json; do
        [ -f "$f" ] || continue
        found=1
        basename "$f"
    done
    [ "$found" -eq 1 ] || echo "no modes"
}

use_mode() {
    n="$1"
    case "$n" in ''|*[!0-9]*) echo "mode must be numeric" >&2; exit 2;; esac
    src="$BASE/configs/mode${n}.json"
    [ -f "$src" ] || { echo "mode not found: $src" >&2; exit 1; }
    "$BASE/bin/sing-box" check -c "$src"
    cp "$src" "$BASE/runtime/active.json.tmp"
    mv "$BASE/runtime/active.json.tmp" "$BASE/runtime/active.json"
    echo "$n" > "$BASE/runtime/current_mode"
    echo "mode $n selected"
}

post_start() {
    apply_guard
    apply_full_proxy
}

cmd="${1:-}"
case "$cmd" in
    status) status ;;
    preflight) "$PREFLIGHT" ;;
    list) list_modes ;;
    use)
        [ $# -eq 2 ] || { usage; exit 2; }
        use_mode "$2"
        ;;
    start)
        [ $# -le 2 ] || { usage; exit 2; }
        if [ $# -eq 2 ]; then use_mode "$2"; fi
        "$START"
        post_start
        ;;
    stop)
        [ $# -eq 1 ] || { usage; exit 2; }
        "$STOP"
        ;;
    restart)
        [ $# -le 2 ] || { usage; exit 2; }
        "$STOP"
        if [ $# -eq 2 ]; then use_mode "$2"; fi
        "$START"
        post_start
        ;;
    check)
        if [ $# -eq 2 ]; then "$BASE/bin/sing-box" check -c "$BASE/configs/mode$2.json";
        else "$BASE/bin/sing-box" check -c "$BASE/runtime/active.json"; fi
        ;;
    traffic)
        [ $# -eq 2 ] || { usage; exit 2; }
        "$TRAFFIC" "$2"
        apply_guard
        apply_full_proxy
        ;;
    device)
        [ $# -eq 3 ] || { usage; exit 2; }
        "$TRAFFIC" device "$2" "$3"
        apply_guard
        apply_full_proxy
        ;;
    guard)
        [ -x "$GUARD" ] || { echo "guard-control.sh missing" >&2; exit 1; }
        case "${2:-}" in
            status) [ $# -eq 2 ] || { usage; exit 2; }; "$GUARD" status ;;
            udp|ipv6)
                [ $# -eq 3 ] || { usage; exit 2; }
                "$GUARD" "$2" "$3"
                apply_full_proxy
                ;;
            *) usage; exit 2 ;;
        esac
        ;;
    fullproxy)
        [ -x "$UDP_TUN" ] || { echo "udp-tun.sh missing" >&2; exit 1; }
        case "${2:-}" in
            status) [ $# -eq 2 ] || { usage; exit 2; }; "$UDP_TUN" status ;;
            on|apply) [ $# -eq 2 ] || { usage; exit 2; }; "$UDP_TUN" apply ;;
            off) [ $# -eq 2 ] || { usage; exit 2; }; "$UDP_TUN" off ;;
            *) usage; exit 2 ;;
        esac
        ;;
    *) usage; exit 2 ;;
esac
